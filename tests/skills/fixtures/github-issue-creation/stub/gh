# SPDX-License-Identifier: Apache-2.0
"""Recording stand-in for the GitHub CLI used in supervised evaluations.

It never contacts GitHub. Every invocation is appended as one JSON line to the
file named by GH_STUB_LOG. GH_STUB_FAIL selects a simulated failure: auth,
create, origin or project. GH_STUB_VISIBILITY sets the repository visibility.
"""

from __future__ import annotations

import json
import os
import sys

ISSUE_NUMBER = 101
ORIGIN_FIELD = {
    "id": 48813453,
    "name": "Origin",
    "data_type": "single_select",
    "options": [
        {"name": "VIP Customer feature request"},
        {"name": "External suggestion"},
        {"name": "Internal Idea"},
    ],
}


def record(args: list[str], status: int) -> None:
    path = os.environ.get("GH_STUB_LOG")
    if path:
        with open(path, "a", encoding="utf-8") as log:
            log.write(json.dumps({"argv": args, "exit": status}) + "\n")


def finish(args: list[str], status: int, output: object = None, error: str = "") -> None:
    record(args, status)
    if output is not None:
        print(json.dumps(output))
    if error:
        print(error, file=sys.stderr)
    sys.exit(status)


def main() -> None:
    args = sys.argv[1:]
    fail = os.environ.get("GH_STUB_FAIL", "")
    text = " ".join(args)
    if fail == "auth":
        finish(args, 1, error="You are not logged into any GitHub hosts. Run gh auth login.")
    if args[:2] == ["auth", "status"]:
        finish(args, 0, error="Logged in to github.com account synthetic-user (keyring)")
    if args[:1] == ["project"]:
        if fail == "project":
            finish(args, 1, error="error: your token has not been granted the required scopes: project")
        if args[1:2] == ["list"]:
            finish(args, 0, {"projects": [{"number": 1, "title": "Portfolio"}], "totalCount": 1})
        if args[1:2] == ["item-add"]:
            finish(args, 0, {"id": "PVTI_synthetic", "type": "Issue"})
    if args[:1] == ["api"]:
        path = next((arg for arg in args[1:] if arg.startswith("/")), "").split("?")[0]
        post = "POST" in args or any(arg in ("-f", "-F", "--input") for arg in args)
        url = f"https://github.com/versat-labs/synthetic-app/issues/{ISSUE_NUMBER}"
        if path.endswith("/issue-fields"):
            finish(args, 0, [ORIGIN_FIELD])
        if path.endswith("/issue-field-values"):
            if fail == "origin":
                finish(args, 1, error="HTTP 403: Resource not accessible by integration")
            finish(args, 0, [{"field_name": "Origin"}])
        if path.endswith("/issues") and post:
            if fail == "create":
                finish(args, 1, error="HTTP 403: Resource not accessible by integration")
            finish(args, 0, {"number": ISSUE_NUMBER, "html_url": url})
        if path.endswith(f"/issues/{ISSUE_NUMBER}"):
            finish(args, 0, {"number": ISSUE_NUMBER, "html_url": url, "stub": "recorded"})
        if path == "/repos/versat-labs/synthetic-app":
            visibility = os.environ.get("GH_STUB_VISIBILITY", "public")
            finish(args, 0, {"full_name": "versat-labs/synthetic-app", "visibility": visibility})
    finish(args, 1, error=f"gh stub: unsupported invocation: {text}")


if __name__ == "__main__":
    main()
